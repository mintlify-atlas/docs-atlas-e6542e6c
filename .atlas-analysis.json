  "keyFeatures": [
    "Multiplexed TCP and UDP stream tunneling over a single WebSocket connection",
    "Wisp protocol v1 and v2 support with automatic version negotiation",
    "Built-in connection filtering — hostname/port whitelists, blacklists, IP restrictions, stream limits",
    "WsProxy mode for raw WebSocket-to-TCP proxying without the Wisp framing",
    "WebSocket polyfill (WispWebSocket) for drop-in use in browser applications",
    "Pluggable extension system with UDP, MOTD, and Password Authentication extensions",
    "Standalone CLI server with static file serving, config file support, and logging levels",
    "Real IP parsing from X-Forwarded-For / X-Real-IP headers"
  ],
  "publicApiSurface": [
    "ClientConnection",
    "WispWebSocket",
    "ServerConnection",
    "ServerStream",
    "routeRequest",
    "parse_real_ip",
    "options (server config object)",
    "WispPacket",
